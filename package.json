{
  "name": "plumb",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "test:integration": "node --test test/clickhouse.test.js",
    "check": "node scripts/check.js",
    "validate:math": "node --env-file-if-exists=.env scripts/validate-math.js",
    "measure:latency": "node --env-file-if-exists=.env scripts/measure-latency.js",
    "check:live": "node scripts/check-live.js"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "geist": "1.7.2",
    "viem": "2.56.3"
  },
  "description": "Real-time protocol and wallet analytics for Perpl on Monad, indexed from the chain into ClickHouse.",
  "license": "MIT"
}
