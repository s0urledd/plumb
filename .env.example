# --- Chain ------------------------------------------------------------------
# Monad JSON-RPC used for live ingest and contract state: a Monad node, or
# https://rpc1.monad.xyz without one (rate-limited; set it as the archive too).
# From inside docker compose, a node on the same host is host.docker.internal.
MONAD_RPC_URL=
CHAIN_ID=143
# Changing it? Change deploy/monode/restricted_filters.json too.
EXCHANGE_ADDRESS=0x34B6552d57a35a1D042CcAe1951BD1C370112a6F
# Optional wake-up sources; both can run, and polling covers them failing.
# MONODE_WS_URL=ws://monode:8443      # compose profile exec-events (fastest)
# MONAD_WS_URL=                       # eth_subscribe newHeads endpoint

# --- History ----------------------------------------------------------------
# The node serves recent logs; older ranges come from archive endpoints
# (comma-separated) during the one-time backfill from the deploy block.
# ARCHIVE_RPC_URLS=https://rpc1.monad.xyz,https://rpc2.monad.xyz
# ARCHIVE_CONCURRENCY=4
# LIVE_HISTORY_BLOCKS=600000          # how far back the node serves eth_getLogs
# LIVE_LOG_RANGE=1000                 # blocks per eth_getLogs request

# --- Storage ----------------------------------------------------------------
CLICKHOUSE_PASSWORD=
# CLICKHOUSE_URL=http://127.0.0.1:8123  # set by docker compose
# CLICKHOUSE_USER=perpl
# CLICKHOUSE_DB=perpl

# --- Server -----------------------------------------------------------------
# PORT=8787
# HOST=127.0.0.1
# BIND_ADDR=127.0.0.1                 # compose: host address the app is published on
# EVENT_RING_DIR=/var/lib/hugetlbfs/user/monad/pagesize-2MB/event-rings

# --- Alerts -----------------------------------------------------------------
# Telegram bot token from @BotFather; unset, no bot runs.
# TELEGRAM_BOT_TOKEN=
# PUBLIC_URL=https://plumb.example.com  # links in alert messages
