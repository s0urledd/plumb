<!-- ClickHouse server overrides for Plumb: quiet logging, no high-volume
     diagnostic system tables, and three days of the ones that stay. -->
<clickhouse>
  <logger>
    <level>warning</level>
  </logger>
  <trace_log remove="1"/>
  <text_log remove="1"/>
  <metric_log remove="1"/>
  <asynchronous_metric_log remove="1"/>
  <query_thread_log remove="1"/>
  <query_views_log remove="1"/>
  <processors_profile_log remove="1"/>
  <opentelemetry_span_log remove="1"/>
  <!-- ClickHouse's own diagnostic logs keep three days, enough to look into a
       slow query; without a TTL query_log alone grew about 0.5 GB a day.
       Plumb's data (the perpl database) has no TTL and keeps its full history. -->
  <query_log><ttl>event_date + INTERVAL 3 DAY DELETE</ttl></query_log>
  <query_metric_log><ttl>event_date + INTERVAL 3 DAY DELETE</ttl></query_metric_log>
  <part_log><ttl>event_date + INTERVAL 3 DAY DELETE</ttl></part_log>
  <background_schedule_pool_log><ttl>event_date + INTERVAL 3 DAY DELETE</ttl></background_schedule_pool_log>
  <error_log><ttl>event_date + INTERVAL 3 DAY DELETE</ttl></error_log>
</clickhouse>
